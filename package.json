{
  "name": "emm-fort-app-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev  --turbopack",
     "build": "npm run prisma:generate && prisma migrate deploy && next build",
    "start": "npm run prisma:generate && next start",
    "lint": "next lint",
    "prisma:generate": "npm run prisma:generate:app && npm run prisma:generate:wp",
    "prisma:generate:app": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:generate:wp": "prisma generate --schema=./prisma/wordpress.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.11",
    "lucide-react": "^0.532.0",
    "next": "15.4.4",
    "next-auth": "^5.0.0-beta.29",
    "nodemailer": "^6.10.1",
    "nprogress": "^0.2.0",
    "phpass": "^0.1.1",
    "prisma": "^6.12.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.61.1",
    "react-intersection-observer": "^9.16.0",
    "recharts": "^3.1.0",
    "zod": "^4.0.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "15.4.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
   "prisma": {
    "seed": "ts-node --project tsconfig.seed.json prisma/seed.ts"
  }
}
