}

model wp_yith_wcaf_payment_notes {
  ID           BigInt   @id @default(autoincrement())
  payment_id   BigInt
  note_content String   @db.Text
  note_date    DateTime @default(dbgenerated("('0000-00-00 00:00:00')")) @db.DateTime(0)

  @@index([payment_id], map: "external_payment")
}

