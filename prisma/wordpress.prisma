model wp_yith_wcaf_commission_notes {
  ID            BigInt   @id @default(autoincrement())
  commission_id BigInt
  note_content  String   @db.Text
  note_date     DateTime @default(dbgenerated("('0000-00-00 00:00:00')")) @db.DateTime(0)

  @@index([commission_id], map: "external_commission")
}

model wp_yith_wcaf_commissions {
  ID           BigInt   @id @default(autoincrement())
  order_id     BigInt
  line_item_id BigInt
  product_id   BigInt
