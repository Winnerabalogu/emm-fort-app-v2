generator client {
  provider      = "prisma-client-js"  
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")  
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model User {
  id                      String              @id @default(cuid())
  fullName                String
  username                String              @unique
  email                   String              @unique
  phone                   String
  password                String
  referral                String?
  tier                    Tier                @default(BASIC)
  subscriptionId          String?
  subscriptionStartDate   DateTime?
  subscriptionExpiryDate  DateTime?
  emailVerified           DateTime?           
  role                    Role                @default(USER)               
  verificationToken       String?             @unique
  verificationTokenExpiry DateTime?
  resetToken              String?   
  resetTokenExpiry        DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  uplinerId               String?
  saveRequests            SaveRequest[]
  generatedCommissions    Transaction[]       @relation("CommissionSource")
  transactions            Transaction[]
  upliner                 User?               @relation("Referrals", fields: [uplinerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  referredUsers           User[]              @relation("Referrals")
  withdrawalDetails       WithdrawalDetails?
  withdrawalRequests      WithdrawalRequest[]
  platformSettingsUpdates PlatformSettings[]  @relation("SettingsUpdatedBy")

  @@index([email, emailVerified], map: "User_email_verified_idx")
  @@index([id, tier, subscriptionStartDate], map: "User_id_tier_subscription_idx")
  @@index([tier])
}

model PlatformSettings {
  id        String   @id @default(cuid())
  section   String   @unique
  data      Json
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  updatedByUser User @relation("SettingsUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)
  
  @@index([updatedBy])
  @@index([updatedAt(sort: Desc)])
}

model WithdrawalDetails {
  id            String @id @default(cuid())
  bankName      String
  firstName     String
  lastName      String
  accountNumber String
  userId        String @unique
  user          User   @relation(fields: [userId], references: [id], onUpdate: Restrict)
}

model WithdrawalRequest {
  id        String   @id @default(cuid())
  amount    Float
  status    String   @default("PENDING")
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, status])
}

model SaveRequest {
  id        String   @id @default(cuid())
  amount    Float
  purpose   String
  adminNote String?
  status    String   @default("PENDING")
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, status])
}

model Transaction {
  id           String   @id @default(cuid())
  type         String
  amount       Float
  status       String
  createdAt    DateTime @default(now())
  userId       String
  description String?
  sourceUserId String?
  sourceUser   User?    @relation("CommissionSource", fields: [sourceUserId], references: [id])
  user         User     @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId, status, createdAt])
  @@index([userId, status, type])
}

enum Tier {
  PLATINUM
  GOLD
  SILVER
  BRONZE
  BASIC
}

enum Role {
  USER
  ADMIN
}